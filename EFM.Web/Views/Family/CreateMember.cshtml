@model EFM.Web.Models.FamilyViewModel
@{
    ViewBag.Title = "Thêm mới gia đình";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm("CreateFamily", "Family", FormMethod.Post, new { @class = "form-horizontal", id = "createFamilyForm" }))
{
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <table style="width:100%;">
                        <tr>
                            <td>
                                <h3 class="card-title">Thêm mới gia đình</h3>
                            </td>
                        </tr>
                    </table>
                </div>
                <div id="successMessage" class="alert alert-success" style="display:none;">
                    @TempData["SuccessMessage"]
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.FamilyName, new { @class = "control-label" })
                                @Html.TextBoxFor(model => model.FamilyName, new { @class = "form-control", @placeholder = "Nhập tên gia đình..." })
                                @Html.ValidationMessageFor(model => model.FamilyName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Quantity, new { @class = "control-label" })
                                @Html.TextBoxFor(model => model.Quantity, new { @class = "form-control", @placeholder = "Nhập số lượng thành viên..." })
                                @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    @*<div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Role, new { @class = "control-label" })
                                    @Html.DropDownListFor(model => model.Role, new SelectList(ViewBag.Roles, "Value", "Text", "Admin"), null, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Role, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>*@
                </div>

                <div class="modal-footer d-flex justify-content-start">
                    <button type="submit" id="btnAddNewAccount" class="btn btn-info waves-effect waves-light">Lưu</button>
                    @Html.ActionLink("Quay về danh sách", "Index", "Family", null, new { @class = "btn btn-secondary waves-effect waves-light" })
                </div>
            </div>
        </div>
    </div>
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

<script>
    $(document).ready(function () {
        $('#createAccountForm').on('submit', function (e) {
            e.preventDefault(); // Ngăn gửi form mặc định

            var form = $(this);
            var formData = form.serialize(); // Lấy dữ liệu từ form

            $.ajax({
                url: '/Account/CreateAccount',
                data: formData,
                type: 'POST',
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            title: 'Lưu Thành công!',
                            text: response.message,
                            icon: 'success',
                            confirmButtonText: 'OK'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = "/Account/Index";
                            }
                        });
                    } else {
                        Swal.fire({
                            title: 'Lỗi!',
                            text: response.message || "Có lỗi xảy ra",
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        title: 'Lỗi!',
                        text: "Có lỗi xảy ra khi gửi dữ liệu",
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                }
            });
        });
    });
</script>
