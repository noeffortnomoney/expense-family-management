@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Đăng nhập hệ thống</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="Responsive bootstrap 4 admin template" name="description" />
    <meta content="Coderthemes" name="author" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="/assets/admin/images/logo-sm.png">
    <!-- App css -->
    <link href="/assets/admin/css/bootstrap.min.css" rel="stylesheet" type="text/css" id="bootstrap-stylesheet" />
    <link href="/assets/admin/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/admin/css/app.min.css" rel="stylesheet" type="text/css" id="app-stylesheet" />
    <link href="~/assets/admin/css/login.css" rel="stylesheet" />
</head>
<body class="authentication-page" style="background-image: url('https://png.pngtree.com/thumb_back/fh260/background/20210527/pngtree-mysterious-fantasy-gravity-blur-background-image_721318.jpg');">
    <div class="account-pages my-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6 col-xl-5">
                    <div class="card mt-4">
                        <div class="card-header bg-img p-5 position-relative">
                            <div class="bg-overlay"></div>
                            <h4 class="text-white text-center mb-0">Đăng nhập hệ thống</h4>
                        </div>
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/assets/admin/js/vendor.min.js"></script>
    <script src="/assets/admin/js/app.min.js"></script>
</body>
</html>