@model IEnumerable<EFM.Web.Models.UserViewModel>

@{
    ViewBag.Title = "Danh sách người dùng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section ChildCSS
{
    <link href="/assets/admin/libs/datatables/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/admin/libs/datatables/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/admin/libs/datatables/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/admin/libs/datatables/scroller.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/admin/css/bootstrap.min.css" rel="stylesheet" type="text/css" id="bootstrap-stylesheet" />
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <table style="width:100%;">
                    <tr>
                        <td>
                            <h3 class="card-title">Danh sách tài khoản người dùng</h3>
                        </td>
                        <td style="text-align:right;">
                            <button class="btn btn-primary waves-effect waves-light" id="btnAddNewAccount" data-toggle="modal" data-target="#hop-thoai-modal">Thêm mới</button>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-12">
                        <table id="datatable" class="table table-striped table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
                            <thead>
                                <tr>
                                    <th>@Html.LabelFor(m => m.First().OrderNumber)</th>
                                    <th>@Html.LabelFor(m => m.First().UserName)</th>
                                    <th>@Html.LabelFor(m => m.First().FullName)</th>
                                    <th>@Html.LabelFor(m => m.First().Email)</th>
                                    <th>@Html.LabelFor(m => m.First().PhoneNumber)</th>
                                    <th>@Html.LabelFor(m => m.First().IsActived)</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr id="row_@item.UserID">
                                        <td>
                                            <a href="@Url.Action("DetailAccount", "Account", new { id = item.UserID })">@item.OrderNumber</a>
                                        </td>
                                        <td>@item.UserName</td>
                                        <td>@item.FullName</td>
                                        <td>@item.Email</td>
                                        <td>@item.PhoneNumber</td>
                                        <td>
                                            <a href="#" class="badge bg-info">
                                                @Html.Raw(item.IsActived ? "<strong>Kích hoạt</strong>" : "<font style='color:red; background-color: white;'>Khóa</font>")
                                            </a>
                                        </td>
                                        <td style="text-align:center;width:15px;vertical-align:middle;">

                                            <a class="badge btn-link custom-icon-wrapper" href="#" id="alert_@item.UserID"
                                               role="button" data-toggle="modal" data-target="#con-close-modal-edit-@item.UserID">
                                                <i class="fas fa-edit fa-2x custom-icon-style"></i>
                                            </a>
                                            <a class="badge btn-link custom-icon-wrapper" href="#"
                                               role="button" data-toggle="modal" data-target="#reset-password-modal-@item.UserID">
                                                <i class="fas fa-key fa-2x custom-icon-style"></i>
                                            </a>
                                            <a href="@Url.Action("DeleteConfirmed", new { id = item.UserID })"
                                               class="badge btn-link custom-icon-wrapper"
                                               data-ajax="true"
                                               data-ajax-confirm="Bạn có muốn xóa tài khoản không?"
                                               data-ajax-method="DELETE"
                                               data-ajax-success="$('#row_@item.UserID').remove()">
                                                <i class="fas fa-trash fa-2x custom-icon-style"></i>
                                            </a>
                                            <div class="modal fade" id="reset-password-modal-@item.UserID" tabindex="-1" role="dialog" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
                                                <div class="modal-dialog" role="document">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="resetPasswordModalLabel">Cấp lại mật khẩu cho @item.UserName</h5>
                                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                <span aria-hidden="true">&times;</span>
                                                            </button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <input type="text" id="new-password-@item.UserID" class="form-control" value="1234567" />
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-primary reset-password-btn" data-userid="@item.UserID">Lưu</button>
                                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>                                     
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section ChildJS
{
    <script src="/assets/admin/libs/bootstrap/js/bootbox.min.js"></script>

    // Khai báo thư viện để có thể chạy được Ajax
    <script src="/assets/admin/libs/jquery/jquery.min.js"></script>
    <script src="/assets/admin/libs/jquery/jquery.unobtrusive-ajax.min.js"></script>
    <script src="/assets/admin/libs/jquery-easing/jquery.easing.min.js"></script>

    <script src="/assets/admin/libs/datatables/jquery.dataTables.min.js"></script>
    <script src="/assets/admin/libs/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="/assets/admin/libs/datatables/dataTables.responsive.min.js"></script>
    <script src="/assets/admin/libs/datatables/responsive.bootstrap4.min.js"></script>
    <script src="/assets/admin/libs/datatables/dataTables.buttons.min.js"></script>
    <script src="/assets/admin/libs/datatables/buttons.bootstrap4.min.js"></script>
    <script src="/assets/admin/libs/jszip/jszip.min.js"></script>
    <script src="/assets/admin/libs/pdfmake/pdfmake.min.js"></script>
    <script src="/assets/admin/libs/pdfmake/vfs_fonts.js"></script>
    <script src="/assets/admin/libs/datatables/buttons.print.min.js"></script>
    <script src="/assets/admin/libs/datatables/dataTables.keyTable.min.js"></script>
    <script src="/assets/admin/libs/datatables/dataTables.scroller.min.js"></script>

    <!-- Datatables init -->
    <script src="/assets/admin/js/pages/datatables.init.js"></script>

    <script src="/assets/admin/controller/userController.js"></script>
}
<style>
    .custom-icon-wrapper {
        display: inline-block;
        width: 40px;
        height: 40px;
        background-color: #f0f0f0;
        border-radius: 5px;
        text-align: center;
        line-height: 40px;
        margin-right: 5px;
    }

    .custom-icon-style {
        font-size: 1.5em;
        color: #333333;
    }
</style>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.min.js"></script>
<script>
    $(document).ready(function() {
    $('.reset-password-btn').click(function() {
        var userId = $(this).data('userid');
        var newPassword = $('#new-password-' + userId).val();

        $.ajax({
            url: '@Url.Action("ResetPassword", "Account")',
            type: 'POST',
            data: { userId: userId, newPassword: newPassword },
            success: function(result) {
                if (result.success) {
                    alert(result.message);
                    $('#reset-password-modal-' + userId).hide();
                    $('body').removeClass('modal-open');
                    $('.modal-backdrop').remove();
                } else {
                    alert(result.message);
                }
            },
            error: function() {
                alert('An error occurred while resetting the password.');
            }
        });
    });
    $('.modal').on('shown.bs.modal', function () {
            var userId = $(this).find('.reset-password-btn').data('userid');
            $('#new-password-' + userId).val('1234567');
        });
});
</script>
